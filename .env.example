APP_NAME=InsulaCRM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insulacrm
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=file
# CACHE_PREFIX=
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=default
# DB_CACHE_LOCK_TABLE=cache_locks

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# REDIS_URL=
# REDIS_USERNAME=null
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="\${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenSign e-signature integration
# Use the OpenSign sandbox while testing, or your self-hosted OpenSign API URL.
OPENSIGN_BASE_URL=https://sandbox.opensignlabs.com/api/v1.2
OPENSIGN_API_TOKEN=
OPENSIGN_WEBHOOK_SECRET=
OPENSIGN_SENDER_NAME="\${APP_NAME}"
OPENSIGN_SENDER_EMAIL="\${MAIL_FROM_ADDRESS}"

VITE_APP_NAME="\${APP_NAME}"
