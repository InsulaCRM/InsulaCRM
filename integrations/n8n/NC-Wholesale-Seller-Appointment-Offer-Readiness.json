          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({custom_fields:{nc_wholesale_readiness:$json.readiness}})}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "r4",
      "name": "Persist Readiness",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
